    # renpy/common/00console.rpy:501
    old "Press <esc> to exit console. Type help for help.\n"
    new "Нажмите <esc>, чтобы выйти из консоли. Введите help для помощи.\n"

    # renpy/common/00console.rpy:505
    old "Ren'Py script enabled."
    new "Скрипт Ren'Py активирован."

    # renpy/common/00console.rpy:507
    old "Ren'Py script disabled."
    new "Скрипт Ren'Py деактивирован."

    # renpy/common/00console.rpy:690
    old "The console is using short representations. To disable this, type 'long', and to re-enable, type 'short'"
    new "Консоль использует сокращённые представления. Чтобы отключить это, введите 'long', а чтобы включить снова, введите 'short'"

    # renpy/common/00console.rpy:762
    old "help: show this help\n help <expr>: show signature and documentation of <expr>"
    new "help: показать эту справку\n help <выражение>: показать подпись и документацию к <выражение>"

    # renpy/common/00console.rpy:786
    old "Help may display undocumented functions. Please check that the function or\nclass you want to use is documented.\n\n"
    new "В справке могут отображаться незадокументированные функции. Проверьте,\nчто функция или класс, который вы хотите использовать, задокументирован.\n\n"

    # renpy/common/00console.rpy:795
    old "commands:\n"
    new "команды:\n"

    # renpy/common/00console.rpy:805
    old " <renpy script statement>: run the statement\n"
    new " <оператор скрипта renpy>: выполнить оператор\n"

    # renpy/common/00console.rpy:807
    old " <python expression or statement>: run the expression or statement"
    new " <выражение или оператор python>: выполнить выражение или оператор"

    # renpy/common/00console.rpy:815
    old "clear: clear the console history"
    new "clear: очистить историю консоли"

    # renpy/common/00console.rpy:819
    old "exit: exit the console"
    new "exit: выход из консоли"

    # renpy/common/00console.rpy:827
    old "stack: print the return stack"
    new "stack: вывести стек возврата"

    # renpy/common/00console.rpy:849
    old "load <slot>: loads the game from slot"
    new "load <слот>: загрузить игру из выбранного слота"

    # renpy/common/00console.rpy:862
    old "save <slot>: saves the game in slot"
    new "save <слот>: сохранить игру в выбранный слот"

    # renpy/common/00console.rpy:873
    old "reload: reloads the game, refreshing the scripts"
    new "reload: перезагрузить игру и обновить скрипты"

    # renpy/common/00console.rpy:881
    old "watch <expression>: watch a python expression\n watch short: makes the representation of traced expressions short (default)\n watch long: makes the representation of traced expressions as is"
    new "watch <выражение>: наблюдать за выражением python\n watch short: сокращает отображение отслеживаемых выражений (по умолчанию)\n watch long: отображать отслеживаемые выражений как есть"

    # renpy/common/00console.rpy:918
    old "unwatch <expression>: stop watching an expression"
    new "unwatch <выражение>: прекратить наблюдать за выражением"

    # renpy/common/00console.rpy:964
    old "unwatchall: stop watching all expressions"
    new "unwatchall: прекратить наблюдать за всеми выражениями"

    # renpy/common/00console.rpy:985
    old "jump <label>: jumps to label"
    new "jump <label>: прыжок на метку"

    # renpy/common/00console.rpy:1001
    old "short: Shorten the representation of objects on the console (default)."
    new "short: сокращённое представление объектов в консоли (по умолчанию)."

    # renpy/common/00console.rpy:1005
    old "long: Print the full representation of objects on the console."
    new "long: выводить полное представление объектов в консоли."

    # renpy/common/00console.rpy:1009
    old "escape: Enables escaping of unicode symbols in unicode strings."
    new "escape: включить экранирование Unicode символов в строках Unicode."

    # renpy/common/00console.rpy:1013
    old "unescape: Disables escaping of unicode symbols in unicode strings and print it as is (default)."
    new "unescape: выключить экранирование Unicode символов в строках Unicode и выводить их как есть (по умолчанию)."

